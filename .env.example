# Salin file ini menjadi .env lalu sesuaikan. Semua baris opsional.

# Port & alamat server
PORT=8080
HOST=0.0.0.0

# Folder penyimpanan data (database JSON, sesi login, backup harian)
DATA_DIR=data

# Zona waktu untuk check-in absensi & backup harian
APP_TZ=Asia/Jakarta

# Lama sesi login (jam) dan "Ingat saya" (hari)
SESSION_HOURS=12
REMEMBER_DAYS=30

# Jumlah backup harian yang disimpan
BACKUP_KEEP=30

# Isi "true" kalau server di belakang reverse proxy (Nginx/Caddy/Cloud Run) supaya IP asli terbaca
TRUST_PROXY=false

# AI (Ask Me!, ringkasan AI, scan nota, baca foto mutasi). Kosongkan untuk menonaktifkan.
# Buat API key di https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Alamat aplikasi setelah online (dipakai di link notifikasi & QR), contoh https://erp.lashbounty.com
APP_URL=

# Jam backup otomatis & pengingat harian (zona APP_TZ)
BACKUP_HOUR=2
REMINDER_HOUR=9

# ---- Email (kirim laporan, slip, pengumuman, notifikasi). Contoh Gmail: buat "App password" di akun Google.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=finance@lashbounty.com
# SMTP_PASS=app-password-16-huruf
# SMTP_FROM=Lash Bounty <finance@lashbounty.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Telegram (notifikasi & pengingat). Buat bot lewat @BotFather, salin token-nya ke sini.
TELEGRAM_BOT_TOKEN=

# ---- Google Sheet (cermin otomatis semua catatan, hanya baca). Lihat README bagian Integrasi.
GOOGLE_SHEET_ID=
# contoh: GOOGLE_SA_KEY_FILE=data/google-key.json
GOOGLE_SA_KEY_FILE=
SHEETS_SYNC_MINUTES=10
